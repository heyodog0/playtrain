{
  "name": "puzzlescript",
  "version": "0.1.0",
  "title": "PuzzleScript (reference-engine identity family)",
  "kind": "family",
  "note": "The reference engine's own files run inside every bundle: tools/bundle_puzzlescript.mjs concatenates a constants header, src/05_shims.js, reference/js/* in the reference's load order, and src/90_prelude.js with one games/<game>.txt into dist/ps_<game>.js plus a sidecar. Edit src/ only; never reference/, games/*.txt or dist/. The manifest deliberately has no `sources` key (tools/bundle_multifile.py --all would treat the family as one game).",
  "action_space": "ps6: UP LEFT DOWN RIGHT ACTION NOOP (processInput dir codes 0-4, then no input)",
  "max_steps": 1000,
  "obs": {
    "rgb": true,
    "rgb_size": 64
  },
  "human": {
    "steps_per_second": 8,
    "controls": "Arrows move, X acts. One key press is one turn.",
    "keymap_overlay": true
  },
