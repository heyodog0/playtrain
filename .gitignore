.DS_Store
__pycache__/
*.pyc
.env
.env.*
!.env.example
# Firebase service-account keys: never in the repo, on any machine.
*serviceAccount*.json
*-firebase-adminsdk-*.json
*.private-key.json

.venv/
node_modules/
package-lock.json  # repo standardizes on pnpm (pnpm-lock.yaml)

build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
*.log
outputs/
logs/
# ...but tab:llm-cost is tokenized from games/logs/ by gen/count_tokens.py, so
# the logs for a paper artifact must be force-added (`git add -f`) or the table
# stops being checkable.
# Refine writes a timestamped copy of the previous file here on every edit.
games/backups/

# Rust build artifacts (rasterizer crate); the built .wasm is committed at runtime/p5/
target/
examples/games/js/*_dbg.js
native/jit/fuzz/

# Consumer-repo games synced in by `just sync-analogen`. These are copies whose
# canonical home is the sibling analogen repo (analogen/games/js/); tracking them
# here duplicated them and made every branch switch fail on "untracked working
# tree files would be overwritten". Gate them in place instead:
#   PLAYTRAIN_GAMES_DIR=../../analogen/games/js native/gate_qjs.sh --all
examples/games/js/analogen_*.js
examples/games/js/a-cq-*.js

# Generation / refinement artifacts (regenerated by the pipeline)
outputs/refine_vs_rom/
outputs/

# Vercel CLI project link (contains project/org ids, not secrets)
.vercel/
.vercel
