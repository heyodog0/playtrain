.DS_Store
__pycache__/
*.pyc
.env
.env.*
!.env.example
# Firebase service-account keys: never in the repo, on any machine.
*serviceAccount*.json
*-firebase-adminsdk-*.json
*.private-key.json

.venv/
node_modules/
package-lock.json  # repo standardizes on pnpm (pnpm-lock.yaml)

build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
*.log
outputs/
logs/
# ...but tab:llm-cost is tokenized from reproduction/data/generation-logs/ by
# gen/count_tokens.py, so
# the logs for a paper artifact must be force-added (`git add -f`) or the table
# stops being checkable.
# Refine writes a timestamped copy of the previous file here on every edit.
games/backups/

# Rust build artifacts (rasterizer crate); the built .wasm is committed at runtime/p5/
target/
examples/games/js/*_dbg.js
native/jit/fuzz/

# Games synced in from a consumer repo. Copies whose canonical home is elsewhere,
# so they are not tracked here.
examples/games/js/a-cq-*.js

# Generation / refinement artifacts (regenerated by the pipeline)
outputs/refine_vs_rom/
outputs/

# Vercel CLI project link (contains project/org ids, not secrets)
.vercel/
.vercel


# Trained-policy checkpoints pulled from FASRC to render the header rollouts.
# The working copies live one level up (../checkpoints, ../checkpoints_ppo, both
# outside any repo); these entries cover the case of copying them in here.
checkpoints/
checkpoints_ppo/

reproduction/data/generation-logs/*.json

# Fetched by reproduction/figures/fetch_data.sh, never committed.
reproduction/figures/playtrain-figure-data.tar.gz
reproduction/figures/outputs/
reproduction/out/
reproduction/figures/_*_curves.json

# Generated by reproduce.sh; outputs belong in reproduction/out/
reproduction/out/
reproduction/figures/fig_*.png
reproduction/figures/fig_*.pdf
