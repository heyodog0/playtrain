examples/games/js/*_dbg.js
native/jit/fuzz/

# Consumer-repo games synced in by `just sync-analogen`. These are copies whose
# canonical home is the sibling analogen repo (analogen/games/js/); tracking them
# here duplicated them and made every branch switch fail on "untracked working
# tree files would be overwritten". Gate them in place instead:
#   PLAYTRAIN_GAMES_DIR=../../analogen/games/js native/gate_qjs.sh --all
examples/games/js/analogen_*.js
examples/games/js/a-cq-*.js

# Generation / refinement artifacts (regenerated by the pipeline)
outputs/refine_vs_rom/
outputs/
