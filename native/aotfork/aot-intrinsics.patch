+/* ---- PlayTrain E3 (PLAN-engine-tier-round6.md): p5 intrinsics ----------------
+   `qjsc -P <file>` loads "name min_argc" lines. At every `get_var <name>` ...
+   `call<N>` site whose argument window is straight-line code with a statically
+   known stack effect, the emitter adds a guarded fast path in front of the
+   verbatim call body: if the callee object is the one the host captured for
+   <name> in this context (ctx->aot_intr[k], a strong reference held by the
+   host, so the pointer can never be reused), call the binding's own C function
+   directly through the host-provided wrapper aot_intr_<name>(), skipping
+   JS_CallInternal + js_call_c_function (dispatch, stack check, frame push,
+   argument padding). Same function, same arguments, same this (undefined):
+   exact by construction. min_argc = the number of arguments the binding reads
+   unconditionally; below that the generic path's padding is observable, so the
+   fast path is not emitted. */
+typedef struct { char name[48]; int min_argc; } AOTIntr;
+static AOTIntr aot_intr_tab[128];
+static int aot_intr_n = 0;
+
+int aot_load_intrinsics(const char *path) {
+    FILE *f = fopen(path, "r");
+    char nm[48]; int mn;
+    if (!f) return -1;
+    while (aot_intr_n < 128 && fscanf(f, "%47s %d", nm, &mn) == 2) {
+        snprintf(aot_intr_tab[aot_intr_n].name, sizeof(aot_intr_tab[0].name), "%s", nm);
+        aot_intr_tab[aot_intr_n].min_argc = mn;
+        aot_intr_n++;
+    }
+    fclose(f);
+    return aot_intr_n;
+}
+
+void aot_emit_intrinsic_prologue(FILE *fo) {
+    for (int k = 0; k < aot_intr_n; k++)
+        fprintf(fo, "JSValue aot_intr_%s(JSContext *ctx, JSValue this_val, int argc, JSValue *argv);\n", aot_intr_tab[k].name);
+    if (aot_intr_n) fprintf(fo, "\n");
+}
+
+static int aot_intr_lookup(JSContext *ctx, JSAtom atom) {
+    char buf[64];
+    const char *s;
+    if (!aot_intr_n) return -1;
+    if (__JS_AtomIsTaggedInt(atom)) return -1;
+    s = JS_AtomGetStr(ctx, buf, sizeof(buf), atom);
+    if (!s) return -1;
+    for (int k = 0; k < aot_intr_n; k++)
+        if (!strcmp(s, aot_intr_tab[k].name)) return k;
+    return -1;
+}
+
+/* Pre-pass: intr_at[pc] = intrinsic index for call sites, -1 otherwise.
+   Tracks a relative stack depth through straight-line code; any opcode with a
+   variable or unknown effect, any jump, and any jump target resets the
+   candidate list (conservative: a missed site just keeps the generic body). */
+static void aot_intr_prepass(JSContext *ctx, JSFunctionBytecode *b, const char *jump_target, int8_t *intr_at) {
+    struct { int k, depth; } cand[16];
+    int ncand = 0, depth = 0;
+    for (int pc = 0, pc_next; pc < b->byte_code_len; pc = pc_next) {
+        int op = b->byte_code_buf[pc];
+        const JSOpCode *oi = &short_opcode_info(op);
+        int argc, net, is_call = 0;
+        pc_next = pc + oi->size;
+        intr_at[pc] = -1;
+        if (jump_target[pc]) { ncand = 0; depth = 0; }
+        switch (oi->fmt) {
+        case OP_FMT_npopx:
+            argc = op - OP_call0; net = -argc; is_call = 1; break;
+        case OP_FMT_npop:
+            argc = get_u16(b->byte_code_buf + pc + 1);
+            if (op == OP_call) { net = -argc; is_call = 1; }
+            else if (op == OP_call_method || op == OP_call_constructor) net = -(argc + 1);
+            else if (op == OP_array_from) net = 1 - argc;
+            else goto reset;
+            break;
+        case OP_FMT_npop_u16: case OP_FMT_label8: case OP_FMT_label16: case OP_FMT_label:
+        case OP_FMT_atom_label_u8: case OP_FMT_atom_label_u16: case OP_FMT_label_u16:
+            goto reset;
+        default:
+            if (op == OP_return || op == OP_return_undef || op == OP_return_async || op == OP_throw ||
+                op == OP_ret || op == OP_tail_call || op == OP_tail_call_method || op == OP_nop ||
+                op == OP_catch || op == OP_gosub || op == OP_for_of_next || op == OP_for_in_next || op == OP_for_await_of_next ||
+                op == OP_iterator_next || op == OP_iterator_call || op == OP_with_get_var || op == OP_with_put_var ||
+                op == OP_with_delete_var || op == OP_with_make_ref || op == OP_with_get_ref || op == OP_await || op == OP_yield ||
+                op == OP_yield_star || op == OP_async_yield_star || op == OP_initial_yield)
+                goto reset;
+            net = oi->n_push - oi->n_pop;
+            break;
+        }
+        if (is_call) {
+            int slot = depth - argc - 1;           /* relative depth of the callee */
+            if (slot < 0) goto reset;
+            while (ncand && cand[ncand - 1].depth > slot) ncand--;   /* consumed as arguments */
+            if (ncand && cand[ncand - 1].depth == slot) {
+                if (argc >= aot_intr_tab[cand[ncand - 1].k].min_argc)
+                    intr_at[pc] = cand[ncand - 1].k;
+                ncand--;
+            }
+        } else if (net < 0) {
+            while (ncand && cand[ncand - 1].depth >= depth + net) ncand--;
+        }
+        if (op == OP_get_var && ncand < 16) {   /* operand = closure-var index (var_ref format in this fork) */
+            int idx = get_u16(b->byte_code_buf + pc + 1);
+            int k = (idx < b->closure_var_count) ? aot_intr_lookup(ctx, b->closure_var[idx].var_name) : -1;
+            if (k >= 0) { cand[ncand].k = k; cand[ncand].depth = depth; ncand++; }
+        }
+        depth += net;
+        if (depth < 0) goto reset;
+        continue;
+    reset:
+        ncand = 0; depth = 0;
+    }
+}
