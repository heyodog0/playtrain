+/* ==================== qjit live trace: decode + compile + enter ==================== */
+static int qjit_on(void) { static int e = -1; if (e < 0) e = getenv("QJIT_ENABLE") ? 1 : 0; return e; }
+
+/* map a frame slot (is_arg, idx) to a dense L[] index, recording the reverse map. */
+static int qjit_getL(int is_arg, int idx, int *loc2L, int *arg2L, QjitTrace *tr) {
+    int *m = is_arg ? arg2L : loc2L;
+    if (idx < 0 || idx >= 1024 || tr->n_live >= 64) return -1;
+    if (m[idx] >= 0) return m[idx];
+    int L = tr->n_live++;
+    m[idx] = L; tr->live_is_arg[L] = (unsigned char)is_arg; tr->live_idx[L] = idx;
+    return L;
+}
+
+static int qjit_opcode_size(int op) {
+    static const unsigned char qjit_sizes[] = {
+#define DEF(id, size, n_pop, n_push, f) size,
+#include "quickjs-opcode.h"
+#undef DEF
+    };
+    if (op < 0 || op >= (int)(sizeof(qjit_sizes) / sizeof(qjit_sizes[0]))) return 1;
+    return qjit_sizes[op];
+}
