 /* argv[] is modified if (flags & JS_CALL_FLAG_COPY_ARGV) = 0. */
+/* --- qjit: resolve a JSFunctionBytecode* to its function name (report-time) --- */
+#include "qjit.h"
+const char *qjit_fn_name(void *ctx_, const void *b_) {
+    JSContext *ctx = (JSContext *)ctx_;
+    const JSFunctionBytecode *b = (const JSFunctionBytecode *)b_;
+    return JS_AtomToCString(ctx, b->func_name);
+}
