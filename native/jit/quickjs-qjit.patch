+        else if (op == OP_get_length) { EMIT(Q_ARRAY_LENGTH); }                       // dedicated .length op
+        else if (op == OP_drop) { EMIT(Q_DROP); }
+        else if (op == OP_dup)  { EMIT(Q_DUP); }
+        else if (op == OP_nop)  { EMIT(Q_NOP); }
+        else { ok = 0; break; }   // unsupported opcode -> abort (stay interpreted)
+    }
+    if (ok && !getenv("QJIT_NOCOMPILE")) {
+        static IRInsn ir[512]; int ir_n, n_exits;
+        // tr.live_kind is zeroed (memset above) -> defaults to QK_INT; the builder
+        // flips array-base slots to QK_ARRAY and float slots to QK_FLOAT. qjit_try_enter
+        // reads it to marshal. in_ty: the ENTRY type of each live slot, read from the live
+        // frame (var_buf/arg_buf tag) — this is how the builder learns a slot is a float
+        // (QK_FLOAT) without any recorder change (types are known at compile time here).
+        unsigned char in_ty[64]; memset(in_ty, QK_INT, sizeof in_ty);   // QK_INT == 0
+        for (int k = 0; k < tr.n_live && k < 64; k++) {
+            JSValue vv = tr.live_is_arg[k] ? arg_buf[tr.live_idx[k]] : var_buf[tr.live_idx[k]];
+            if (JS_TAG_IS_FLOAT64(JS_VALUE_GET_TAG(vv))) in_ty[k] = QK_FLOAT;
+        }
+        if (qjit_build_ir(tops, nt, ir, 512, &ir_n, &n_exits, tr.exit_pc, tr.live_kind, in_ty) == 0) {
+            void *fn = (void *)qjit_ir_compile(ir, ir_n, n_exits);
+            if (fn) { tr.fn = fn; tr.n_exits = n_exits; tr.valid = 1; }
+        }
+    }
+    if (getenv("QJIT_DEBUG")) {
+        fprintf(stderr, "[qjit] COMPILE %s anchor=%d nrec=%d nt=%d ok=%d valid=%d nlive=%d\n",
+                qjit_fn_name(ctx, b), anchor, nrec, nt, ok, tr.valid, tr.n_live);
+        fprintf(stderr, "  raw recorded ops:");
+        for (int i = 0; i < nrec; i++) fprintf(stderr, " %d@%d", qjit_rec_opcode(i), qjit_rec_off(i));
+        fprintf(stderr, "\n  key OPs: get_loc0=%d get_loc3=%d get_arg0=%d add_loc=%d lt=%d if_true=%d if_false=%d goto8=%d put_loc0=%d set_loc=%d push_0=%d dup=%d get_loc=%d\n",
+                OP_get_loc0, OP_get_loc3, OP_get_arg0, OP_add_loc, OP_lt, OP_if_true, OP_if_false, OP_goto8, OP_put_loc0, OP_set_loc, OP_push_0, OP_dup, OP_get_loc);
+    }
+    qjit_store_trace(&tr);   // store valid OR invalid (memoize; don't recompile)
+    qjit_rec_consume();
+#undef GETL
+#undef EMIT
+}
+
+/* --- IR_CALL host helper: resolve a global fn by atom, call it with int args, free.
+   Matches OP_get_var (JS_GetGlobalVar, throw=1) + OP_call (this=undefined) + OP_drop
+   (free result). Ints need no freeing. The trace only emits this for side-effect calls
+   whose result is dropped; assumes the callee (a p5 primitive) does not throw. */
+static JSContext *qjit_host_ctx = NULL;   // set each entry; the trace's calls read it
+int64_t qjit_call_global(int64_t atom, int64_t argc, int64_t *argv) {
+    JSContext *ctx = qjit_host_ctx;
+    JSValue fn = JS_GetGlobalVar(ctx, (JSAtom)atom, 1);
+    if (unlikely(JS_IsException(fn))) return -1;
+    JSValue jsargs[16];
+    int n = (int)argc; if (n > 16) n = 16;
+    for (int k = 0; k < n; k++) jsargs[k] = JS_MKVAL(JS_TAG_INT, (int32_t)argv[k]);
+    JSValue ret = JS_Call(ctx, fn, JS_UNDEFINED, n, (JSValueConst *)jsargs);
+    JS_FreeValue(ctx, fn);
+    JS_FreeValue(ctx, ret);
+    return 0;
+}
+
+/* --- IR_STREQ_EL helper: (element === atom) via quickjs's own js_strict_eq. `elem`
+   points at the array's JSValue (borrowed — the array owns it, so we neither dup nor
+   free it; js_strict_eq2 takes const args and frees nothing). Content-correct for any
+   element type (string/undefined/etc.), matching OP_strict_eq exactly. */
+int64_t qjit_streq_atom(void *elem, int64_t atom) {
+    JSContext *ctx = qjit_host_ctx;
+    JSValue e = *(JSValue *)elem;                         // borrowed
+    JSValue av = JS_AtomToValue(ctx, (JSAtom)atom);       // owned
+    bool r = js_strict_eq(ctx, e, av);
+    JS_FreeValue(ctx, av);
+    return r ? 1 : 0;
+}
+
+/* --- IR_LOAD_GVAR: resolve a global that must be a fast array -> JSObject* (else 0 -> deopt).
+   Loop-invariant (the global holds the ref, so the pointer stays valid for the trace). */
+int64_t qjit_gvar_array(int64_t atom) {
+    JSContext *ctx = qjit_host_ctx;
+    JSValue v = JS_GetGlobalVar(ctx, (JSAtom)atom, 0);    // throw=0: undefined if missing
+    int64_t r = 0;
+    if (JS_VALUE_GET_TAG(v) == JS_TAG_OBJECT) {
+        JSObject *p = JS_VALUE_GET_OBJ(v);
+        if (p->class_id == JS_CLASS_ARRAY && p->fast_array) r = (int64_t)(intptr_t)p;
+    }
+    JS_FreeValue(ctx, v);                                 // drop the dup; the global keeps it alive
+    return r;
+}
+/* --- IR_ELEM_OBJ: an array element that must be a fast array -> JSObject* (else 0 -> deopt).
+   `addr` points at the (borrowed) element JSValue; the container array keeps it alive. */
+int64_t qjit_elem_array(void *addr) {
+    JSValue v = *(JSValue *)addr;
+    if (JS_VALUE_GET_TAG(v) != JS_TAG_OBJECT) return 0;
+    JSObject *p = JS_VALUE_GET_OBJ(v);
+    return (p->class_id == JS_CLASS_ARRAY && p->fast_array) ? (int64_t)(intptr_t)p : 0;
+}
+
+static int32_t qjit_try_enter(JSContext *ctx, JSFunctionBytecode *b, int32_t anchor,
+                              JSValue *var_buf, JSValue *arg_buf) {
+    if (!qjit_on()) return -1;
+    qjit_host_ctx = ctx;                                  // for the trace's call helper
+    // Bake the struct offsets the heap codegen needs BEFORE compiling — qjit_ir_compile
+    // reads qjit_layout to emit element addressing (JSValue is 16 bytes on 64-bit). If this
+    // ran after qjit_try_compile, the first trace would compile with size=0 (idx*0 -> const).
+    if (!qjit_layout.jsvalue_size) {
+        qjit_layout.arr_count_off   = (int)offsetof(JSObject, u.array.count);
+        qjit_layout.arr_values_off  = (int)offsetof(JSObject, u.array.u.values);
+        qjit_layout.jsvalue_size    = (int)sizeof(JSValue);
+        qjit_layout.jsvalue_tag_off = (int)offsetof(JSValue, tag);
+        qjit_layout.tag_int         = JS_TAG_INT;
+        qjit_layout.tag_float64     = JS_TAG_FLOAT64;
+        qjit_layout.obj_shape_off   = (int)offsetof(JSObject, shape);
+        qjit_layout.obj_prop_off    = (int)offsetof(JSObject, prop);
+        qjit_set_call_helper((void *)&qjit_call_global);   // bind IR_CALL -> host helper
+        qjit_set_streq_helper((void *)&qjit_streq_atom);   // bind IR_STREQ_EL -> host helper
+        qjit_set_gvar_helper((void *)&qjit_gvar_array);    // bind IR_LOAD_GVAR
+        qjit_set_elem_array_helper((void *)&qjit_elem_array); // bind IR_ELEM_OBJ
+    }
+    QjitTrace *t = qjit_lookup_trace(b, anchor);
+    if (!t) { qjit_try_compile(ctx, b, anchor, var_buf, arg_buf); t = qjit_lookup_trace(b, anchor); }
+    if (!t || !t->valid) return -1;
+    int64_t L[64];
+    for (int k = 0; k < t->n_live; k++) {          // entry type guards, kind-specialized
+        if (t->live_kind[k] == QK_SKIP) { L[k] = 0; continue; }  // trace-internal temp: never read
+        JSValue v = t->live_is_arg[k] ? arg_buf[t->live_idx[k]] : var_buf[t->live_idx[k]];
+        if (t->live_kind[k] == QK_ARRAY) {         // must be a fast JS array -> pass JSObject*
+            if (JS_VALUE_GET_TAG(v) != JS_TAG_OBJECT) return -1;
+            JSObject *p = JS_VALUE_GET_OBJ(v);
+            if (p->class_id != JS_CLASS_ARRAY || !p->fast_array) return -1;
+            L[k] = (int64_t)(intptr_t)p;
+        } else if (t->live_kind[k] == QK_FLOAT) {  // float payload: guard FLOAT64, load raw bits
+            if (!JS_TAG_IS_FLOAT64(JS_VALUE_GET_TAG(v))) return -1;   // int-tagged (integral) -> deopt
+            double _d = JS_VALUE_GET_FLOAT64(v); memcpy(&L[k], &_d, 8);
+        } else if (t->live_kind[k] == QK_OBJECT) {  // general object: guard tag==OBJECT, pass ptr
+            if (JS_VALUE_GET_TAG(v) != JS_TAG_OBJECT) return -1;      // in-trace SHAPE guard does the rest
+            L[k] = (int64_t)(intptr_t)JS_VALUE_GET_OBJ(v);
+        } else {                                    // int payload
+            if (JS_VALUE_GET_TAG(v) != JS_TAG_INT) return -1;
+            L[k] = JS_VALUE_GET_INT(v);
+        }
+    }
+    static int dbg = -1, nofire = -1;              // cached: no getenv in the hot path
+    if (dbg < 0) { dbg = getenv("QJIT_DEBUG") ? 1 : 0; nofire = getenv("QJIT_NOFIRE") ? 1 : 0; }
+    if (dbg) fprintf(stderr, "[qjit] FIRE %s anchor=%d nlive=%d\n", qjit_fn_name(ctx, b), anchor, t->n_live);
+    if (nofire) return -1;                          // compile but don't fire (bug isolation)
+    int64_t ex = ((qjit_trace_fn)t->fn)(L);
+    for (int k = 0; k < t->n_live; k++) {          // write back int/float slots (immediates: no free)
+        JSValue nv;
+        if (t->live_kind[k] == QK_INT) nv = JS_MKVAL(JS_TAG_INT, (int32_t)L[k]);
+        else if (t->live_kind[k] == QK_FLOAT) {    // raw-float box (js_float64) — matches the
+            double _d; memcpy(&_d, &L[k], 8);       // interpreter's float arith (no int normalization)
+            nv = js_float64(_d);
+        } else continue;                            // array / trace-internal slots: no writeback
+        if (t->live_is_arg[k]) arg_buf[t->live_idx[k]] = nv; else var_buf[t->live_idx[k]] = nv;
+    }
+    if (ex < 0) return anchor;                      // deopt (any reason): re-run interpreted
+    if (ex >= 0 && ex < t->n_exits) return t->exit_pc[ex];
+    return anchor;
+}
+
+/* --- qjit: opcode -> name (self-contained table, no ENABLE_DUMPS dep) --- */
+const char *qjit_opcode_name(int op) {
+    static const char * const qjit_names[] = {
+#define DEF(id, size, n_pop, n_push, f) #id,
+#include "quickjs-opcode.h"
+#undef DEF
+    };
+    if (op < 0 || op >= (int)(sizeof(qjit_names) / sizeof(qjit_names[0]))) return "<oob>";
+    return qjit_names[op];
+}
+
 static void json_free_token(JSParseState *s, JSToken *token) {
     // Only free actual allocated values
     switch(token->val) {
