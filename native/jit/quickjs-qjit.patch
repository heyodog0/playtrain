+/* decode the recorded trace for (b,anchor), build+compile it, store (valid or invalid). */
+/* --- milestone 3: resolve a field access `obj.atom` against the LIVE object at compile
+   time (V8-style inline cache, built here since this quickjs-ng has no IC opcodes). On
+   success fills *foff (property index into obj->prop[]) + *ftag (0=int, 1=float64) and
+   returns 1. Bails (0 -> trace stays interpreted) on anything not a plain numeric own
+   data property: prototype/missing, getter/varref/autoinit (JS_PROP_TMASK), exotic
+   objects, or a non-numeric value (which would need refcounting on read). */
+static int qjit_resolve_field(JSObject *p, JSAtom atom, int *foff, int *ftag) {
+    JSProperty *pr; JSShapeProperty *prs;
+    if (p->is_exotic) return 0;
+    prs = find_own_property(&pr, p, atom);
+    if (!prs || (prs->flags & JS_PROP_TMASK)) return 0;
+    int tag = JS_VALUE_GET_TAG(pr->u.value);
+    if (tag == JS_TAG_INT) *ftag = 0;
+    else if (JS_TAG_IS_FLOAT64(tag)) *ftag = 1;
+    else return 0;                              /* non-numeric: avoid the refcount minefield */
+    *foff = (int)(pr - p->prop);                /* property index (prop[] entries are 16B) */
+    return 1;
+}
+
+static void qjit_try_compile(JSContext *ctx, JSFunctionBytecode *b, int32_t anchor,
+                             JSValue *var_buf, JSValue *arg_buf) {
+    if (!qjit_rec_ready() || qjit_rec_b() != b || qjit_rec_anchor_off() != anchor) return;
+    if (getenv("QJIT_DUMPBC")) { static int dumped=0; if(!dumped){dumped=1; qjit_dump_bytecode(ctx, b);} }
+    int nrec = qjit_rec_count(), ok = 1;
+    static TraceOp tops[512]; int nt = 0;
+    QjitTrace tr; memset(&tr, 0, sizeof tr); tr.b = b; tr.anchor = anchor;
+    int loc2L[1024], arg2L[1024];
+    for (int i = 0; i < 1024; i++) { loc2L[i] = -1; arg2L[i] = -1; }
+#define GETL(is_arg, idx) qjit_getL(is_arg, idx, loc2L, arg2L, &tr)
+#define EMIT(...) do { if (nt >= 512) { ok = 0; break; } tops[nt++] = (TraceOp){__VA_ARGS__}; } while (0)
+    for (int i = 0; i < nrec && ok; i++) {
+        int off = qjit_rec_off(i), op = qjit_rec_opcode(i);
+        const uint8_t *pc = b->byte_code_buf + off;
+        int L;
+        // milestone 3: fuse `localObj.field` — a get_loc/get_arg immediately followed by
+        // get_field, resolved against the live object. Emits one Q_FIELD_LOC and consumes
+        // both recorded ops. Falls through to the normal handlers if it doesn't apply.
+        {
+            int is_arg = -2, fidx = -1;
+            if (op == OP_get_loc || op == OP_get_loc_check) { is_arg = 0; fidx = get_u16(pc + 1); }
+            else if (op == OP_get_loc8) { is_arg = 0; fidx = pc[1]; }
+            else if (op >= OP_get_loc0 && op <= OP_get_loc3) { is_arg = 0; fidx = op - OP_get_loc0; }
+            else if (op == OP_get_arg) { is_arg = 1; fidx = get_u16(pc + 1); }
+            else if (op >= OP_get_arg0 && op <= OP_get_arg3) { is_arg = 1; fidx = op - OP_get_arg0; }
+            if (is_arg >= 0 && i + 1 < nrec && qjit_rec_opcode(i + 1) == OP_get_field) {
+                JSAtom fatom = get_u32(b->byte_code_buf + qjit_rec_off(i + 1) + 1);  // +1 past opcode
+                JSValue ov = is_arg ? arg_buf[fidx] : var_buf[fidx];
+                int foff, ftag;
+                if (JS_VALUE_GET_TAG(ov) == JS_TAG_OBJECT &&
+                    qjit_resolve_field(JS_VALUE_GET_OBJ(ov), fatom, &foff, &ftag)) {
+                    int Lk = GETL(is_arg, fidx); if (Lk < 0) { ok = 0; break; }
+                    EMIT(Q_FIELD_LOC, .slot = Lk,
+                         .imm = (int64_t)(intptr_t)JS_VALUE_GET_OBJ(ov)->shape,
+                         .foffset = foff, .ftag = ftag);
+                    i++;                        // consume the fused get_field
+                    continue;
+                }
+            }
+        }
+        if (op == OP_get_loc || op == OP_get_loc_check) { L = GETL(0, get_u16(pc + 1)); if (L < 0){ok=0;break;} EMIT(Q_GET_LOC, .slot = L); }
+        else if (op == OP_get_loc8) { L = GETL(0, pc[1]); if(L<0){ok=0;break;} EMIT(Q_GET_LOC, .slot = L); }
+        else if (op >= OP_get_loc0 && op <= OP_get_loc3) { L = GETL(0, op - OP_get_loc0); if(L<0){ok=0;break;} EMIT(Q_GET_LOC, .slot = L); }
+        else if (op == OP_get_loc0_loc1) {   // fused: push var_buf[0] then var_buf[1]
+            int L0 = GETL(0, 0); if(L0<0){ok=0;break;} EMIT(Q_GET_LOC, .slot = L0);
+            int L1 = GETL(0, 1); if(L1<0){ok=0;break;} EMIT(Q_GET_LOC, .slot = L1); }
+        else if (op == OP_put_loc || op == OP_put_loc_check) { L = GETL(0, get_u16(pc + 1)); if(L<0){ok=0;break;} EMIT(Q_PUT_LOC, .slot = L); }
+        else if (op == OP_put_loc8) { L = GETL(0, pc[1]); if(L<0){ok=0;break;} EMIT(Q_PUT_LOC, .slot = L); }
+        else if (op >= OP_put_loc0 && op <= OP_put_loc3) { L = GETL(0, op - OP_put_loc0); if(L<0){ok=0;break;} EMIT(Q_PUT_LOC, .slot = L); }
+        else if (op == OP_set_loc) { L = GETL(0, get_u16(pc + 1)); if(L<0){ok=0;break;} EMIT(Q_SET_LOC, .slot = L); }
+        else if (op == OP_set_loc8) { L = GETL(0, pc[1]); if(L<0){ok=0;break;} EMIT(Q_SET_LOC, .slot = L); }
+        else if (op >= OP_set_loc0 && op <= OP_set_loc3) { L = GETL(0, op - OP_set_loc0); if(L<0){ok=0;break;} EMIT(Q_SET_LOC, .slot = L); }
+        else if (op == OP_get_arg) { L = GETL(1, get_u16(pc + 1)); if(L<0){ok=0;break;} EMIT(Q_GET_LOC, .slot = L); }
+        else if (op >= OP_get_arg0 && op <= OP_get_arg3) { L = GETL(1, op - OP_get_arg0); if(L<0){ok=0;break;} EMIT(Q_GET_LOC, .slot = L); }
+        else if (op == OP_put_arg) { L = GETL(1, get_u16(pc + 1)); if(L<0){ok=0;break;} EMIT(Q_PUT_LOC, .slot = L); }
+        else if (op >= OP_put_arg0 && op <= OP_put_arg3) { L = GETL(1, op - OP_put_arg0); if(L<0){ok=0;break;} EMIT(Q_PUT_LOC, .slot = L); }
+        else if (op == OP_set_arg) { L = GETL(1, get_u16(pc + 1)); if(L<0){ok=0;break;} EMIT(Q_SET_LOC, .slot = L); }
+        else if (op >= OP_set_arg0 && op <= OP_set_arg3) { L = GETL(1, op - OP_set_arg0); if(L<0){ok=0;break;} EMIT(Q_SET_LOC, .slot = L); }
+        else if (op == OP_add_loc) { L = GETL(0, pc[1]); if(L<0){ok=0;break;} EMIT(Q_ADD_LOC, .slot = L); }
+        // inc_loc/dec_loc: var[idx] += 1 / -= 1, in place (no stack effect) -> push k; add_loc
+        else if (op == OP_inc_loc) { L = GETL(0, pc[1]); if(L<0){ok=0;break;} EMIT(Q_PUSH_INT, .imm = 1);  EMIT(Q_ADD_LOC, .slot = L); }
+        else if (op == OP_dec_loc) { L = GETL(0, pc[1]); if(L<0){ok=0;break;} EMIT(Q_PUSH_INT, .imm = -1); EMIT(Q_ADD_LOC, .slot = L); }
+        else if (op == OP_push_i32) { EMIT(Q_PUSH_INT, .imm = (int32_t)get_u32(pc + 1)); }
+        else if (op == OP_push_i16) { EMIT(Q_PUSH_INT, .imm = (int16_t)get_u16(pc + 1)); }
+        else if (op == OP_push_i8)  { EMIT(Q_PUSH_INT, .imm = (int8_t)pc[1]); }
+        else if (op >= OP_push_0 && op <= OP_push_7) { EMIT(Q_PUSH_INT, .imm = op - OP_push_0); }
+        else if (op == OP_push_minus1) { EMIT(Q_PUSH_INT, .imm = -1); }
+        else if (op == OP_push_const8) { JSValue c = b->cpool[pc[1]]; int tg = JS_VALUE_GET_TAG(c);
+            if (tg == JS_TAG_INT) EMIT(Q_PUSH_INT, .imm = JS_VALUE_GET_INT(c));
+            else if (JS_TAG_IS_FLOAT64(tg)) { double _d = JS_VALUE_GET_FLOAT64(c); int64_t _b; memcpy(&_b, &_d, 8); EMIT(Q_PUSH_F64, .imm = _b); }
+            else { ok = 0; break; } }
+        else if (op == OP_push_const) { JSValue c = b->cpool[get_u32(pc + 1)]; int tg = JS_VALUE_GET_TAG(c);
+            if (tg == JS_TAG_INT) EMIT(Q_PUSH_INT, .imm = JS_VALUE_GET_INT(c));
+            else if (JS_TAG_IS_FLOAT64(tg)) { double _d = JS_VALUE_GET_FLOAT64(c); int64_t _b; memcpy(&_b, &_d, 8); EMIT(Q_PUSH_F64, .imm = _b); }
+            else { ok = 0; break; } }
+        else if (op == OP_add) { EMIT(Q_ADD); }
+        else if (op == OP_sub) { EMIT(Q_SUB); }
+        else if (op == OP_mul) { EMIT(Q_MUL); }
+        else if (op == OP_lt)  { EMIT(Q_LT); }
+        else if (op == OP_lte) { EMIT(Q_LE); }
+        else if (op == OP_gt)  { EMIT(Q_GT); }
+        else if (op == OP_gte) { EMIT(Q_GE); }
+        // milestone 2: int32 bitwise / mod / negate / not
+        else if (op == OP_and) { EMIT(Q_AND); }
+        else if (op == OP_or)  { EMIT(Q_OR); }
+        else if (op == OP_xor) { EMIT(Q_XOR); }
+        else if (op == OP_shl) { EMIT(Q_SHL); }
+        else if (op == OP_sar) { EMIT(Q_SAR); }
+        else if (op == OP_mod) { EMIT(Q_MOD); }
+        else if (op == OP_not) { EMIT(Q_NOT); }
+        else if (op == OP_lnot) { EMIT(Q_LNOT); }
+        else if (op == OP_neg) { EMIT(Q_NEG); }
+        // inc/dec/post_inc/post_dec reuse int add (overflow->deopt) + dup; no new IR needed.
+        else if (op == OP_inc) { EMIT(Q_PUSH_INT, .imm = 1);  EMIT(Q_ADD); }
+        else if (op == OP_dec) { EMIT(Q_PUSH_INT, .imm = -1); EMIT(Q_ADD); }
+        else if (op == OP_post_inc) { EMIT(Q_DUP); EMIT(Q_PUSH_INT, .imm = 1);  EMIT(Q_ADD); }
+        else if (op == OP_post_dec) { EMIT(Q_DUP); EMIT(Q_PUSH_INT, .imm = -1); EMIT(Q_ADD); }
+        // Conditionals: emit a guard whose CONTINUE direction is the recorded path and whose
+        // side-exit resumes the OTHER direction. Determine taken/not-taken from the next
+        // recorded op's offset. neg=1 means "continue iff cond FALSE". (Both exits are at
+        // stack-empty points, so resuming needs only var_buf — matches the snapshot-free model.)
+        else if (op == OP_if_false || op == OP_if_true) {
+            int32_t tgt = off + 1 + (int32_t)get_u32(pc + 1), fall = off + 5;
+            int32_t noff = (i + 1 < nrec) ? qjit_rec_off(i + 1) : -1;
+            int taken = (noff == tgt); if (!taken && noff != fall) { ok = 0; break; }
+            int neg = (op == OP_if_false) ? taken : !taken;
+            EMIT(Q_IF_FALSE, .imm = neg, .exit_pc = taken ? fall : tgt);
+        }
+        else if (op == OP_if_false8 || op == OP_if_true8) {
+            int32_t tgt = off + 1 + (int8_t)pc[1], fall = off + 2;
+            int32_t noff = (i + 1 < nrec) ? qjit_rec_off(i + 1) : -1;
+            int taken = (noff == tgt); if (!taken && noff != fall) { ok = 0; break; }
+            int neg = (op == OP_if_false8) ? taken : !taken;
+            EMIT(Q_IF_FALSE, .imm = neg, .exit_pc = taken ? fall : tgt);
+        }
+        else if (op == OP_goto)  { int32_t tgt = off + 1 + (int32_t)get_u32(pc + 1); if (tgt == anchor) EMIT(Q_GOTO_LOOP); else { ok = 0; break; } }
+        else if (op == OP_goto8) { int32_t tgt = off + 1 + (int8_t)pc[1]; if (tgt == anchor) EMIT(Q_GOTO_LOOP); else { ok = 0; break; } }
+        else if (op == OP_goto16){ int32_t tgt = off + 1 + (int16_t)get_u16(pc + 1); if (tgt == anchor) EMIT(Q_GOTO_LOOP); else { ok = 0; break; } }
+        else if (op == OP_get_array_el) { EMIT(Q_GET_ARRAY_EL); }
