+/* decode the recorded trace for (b,anchor), build+compile it, store (valid or invalid). */
+static void qjit_try_compile(JSContext *ctx, JSFunctionBytecode *b, int32_t anchor) {
+    if (!qjit_rec_ready() || qjit_rec_b() != b || qjit_rec_anchor_off() != anchor) return;
+    if (getenv("QJIT_DUMPBC")) { static int dumped=0; if(!dumped){dumped=1; qjit_dump_bytecode(ctx, b);} }
+    int nrec = qjit_rec_count(), ok = 1;
+    static TraceOp tops[512]; int nt = 0;
+    QjitTrace tr; memset(&tr, 0, sizeof tr); tr.b = b; tr.anchor = anchor;
+    int loc2L[1024], arg2L[1024];
+    for (int i = 0; i < 1024; i++) { loc2L[i] = -1; arg2L[i] = -1; }
+#define GETL(is_arg, idx) qjit_getL(is_arg, idx, loc2L, arg2L, &tr)
+#define EMIT(...) do { if (nt >= 512) { ok = 0; break; } tops[nt++] = (TraceOp){__VA_ARGS__}; } while (0)
+    for (int i = 0; i < nrec && ok; i++) {
+        int off = qjit_rec_off(i), op = qjit_rec_opcode(i);
+        const uint8_t *pc = b->byte_code_buf + off;
+        int L;
+        if (op == OP_get_loc || op == OP_get_loc_check) { L = GETL(0, get_u16(pc + 1)); if (L < 0){ok=0;break;} EMIT(Q_GET_LOC, .slot = L); }
+        else if (op == OP_get_loc8) { L = GETL(0, pc[1]); if(L<0){ok=0;break;} EMIT(Q_GET_LOC, .slot = L); }
+        else if (op >= OP_get_loc0 && op <= OP_get_loc3) { L = GETL(0, op - OP_get_loc0); if(L<0){ok=0;break;} EMIT(Q_GET_LOC, .slot = L); }
+        else if (op == OP_put_loc || op == OP_put_loc_check) { L = GETL(0, get_u16(pc + 1)); if(L<0){ok=0;break;} EMIT(Q_PUT_LOC, .slot = L); }
+        else if (op == OP_put_loc8) { L = GETL(0, pc[1]); if(L<0){ok=0;break;} EMIT(Q_PUT_LOC, .slot = L); }
+        else if (op >= OP_put_loc0 && op <= OP_put_loc3) { L = GETL(0, op - OP_put_loc0); if(L<0){ok=0;break;} EMIT(Q_PUT_LOC, .slot = L); }
+        else if (op == OP_set_loc) { L = GETL(0, get_u16(pc + 1)); if(L<0){ok=0;break;} EMIT(Q_SET_LOC, .slot = L); }
+        else if (op == OP_set_loc8) { L = GETL(0, pc[1]); if(L<0){ok=0;break;} EMIT(Q_SET_LOC, .slot = L); }
+        else if (op == OP_get_arg) { L = GETL(1, get_u16(pc + 1)); if(L<0){ok=0;break;} EMIT(Q_GET_LOC, .slot = L); }
+        else if (op >= OP_get_arg0 && op <= OP_get_arg3) { L = GETL(1, op - OP_get_arg0); if(L<0){ok=0;break;} EMIT(Q_GET_LOC, .slot = L); }
+        else if (op == OP_put_arg) { L = GETL(1, get_u16(pc + 1)); if(L<0){ok=0;break;} EMIT(Q_PUT_LOC, .slot = L); }
+        else if (op == OP_set_arg) { L = GETL(1, get_u16(pc + 1)); if(L<0){ok=0;break;} EMIT(Q_SET_LOC, .slot = L); }
+        else if (op == OP_add_loc) { L = GETL(0, pc[1]); if(L<0){ok=0;break;} EMIT(Q_ADD_LOC, .slot = L); }
+        else if (op == OP_push_i32) { EMIT(Q_PUSH_INT, .imm = (int32_t)get_u32(pc + 1)); }
+        else if (op == OP_push_i16) { EMIT(Q_PUSH_INT, .imm = (int16_t)get_u16(pc + 1)); }
+        else if (op == OP_push_i8)  { EMIT(Q_PUSH_INT, .imm = (int8_t)pc[1]); }
+        else if (op >= OP_push_0 && op <= OP_push_7) { EMIT(Q_PUSH_INT, .imm = op - OP_push_0); }
+        else if (op == OP_push_minus1) { EMIT(Q_PUSH_INT, .imm = -1); }
+        else if (op == OP_push_const8) { JSValue c = b->cpool[pc[1]]; if (JS_VALUE_GET_TAG(c) != JS_TAG_INT) { ok = 0; break; } EMIT(Q_PUSH_INT, .imm = JS_VALUE_GET_INT(c)); }
+        else if (op == OP_add) { EMIT(Q_ADD); }
+        else if (op == OP_sub) { EMIT(Q_SUB); }
+        else if (op == OP_mul) { EMIT(Q_MUL); }
+        else if (op == OP_lt)  { EMIT(Q_LT); }
+        else if (op == OP_lte) { EMIT(Q_LE); }
+        else if (op == OP_gt)  { EMIT(Q_GT); }
+        else if (op == OP_gte) { EMIT(Q_GE); }
+        else if (op == OP_if_false) { EMIT(Q_IF_FALSE, .exit_pc = off + 1 + (int32_t)get_u32(pc + 1)); }
+        else if (op == OP_if_false8) { EMIT(Q_IF_FALSE, .exit_pc = off + 1 + (int8_t)pc[1]); }
+        else if (op == OP_goto)  { int32_t tgt = off + 1 + (int32_t)get_u32(pc + 1); if (tgt == anchor) EMIT(Q_GOTO_LOOP); else { ok = 0; break; } }
+        else if (op == OP_goto8) { int32_t tgt = off + 1 + (int8_t)pc[1]; if (tgt == anchor) EMIT(Q_GOTO_LOOP); else { ok = 0; break; } }
+        else if (op == OP_goto16){ int32_t tgt = off + 1 + (int16_t)get_u16(pc + 1); if (tgt == anchor) EMIT(Q_GOTO_LOOP); else { ok = 0; break; } }
+        else if (op == OP_get_array_el) { EMIT(Q_GET_ARRAY_EL); }
+        else if (op == OP_drop) { EMIT(Q_DROP); }
+        else if (op == OP_dup)  { EMIT(Q_DUP); }
+        else if (op == OP_nop)  { EMIT(Q_NOP); }
+        else { ok = 0; break; }   // unsupported opcode -> abort (stay interpreted)
+    }
+    if (ok && !getenv("QJIT_NOCOMPILE")) {
+        static IRInsn ir[512]; int ir_n, n_exits;
+        // tr.live_kind is zeroed (memset above) -> defaults to QK_INT; the builder
+        // flips array-base slots to QK_ARRAY. qjit_try_enter reads it to marshal.
+        if (qjit_build_ir(tops, nt, ir, 512, &ir_n, &n_exits, tr.exit_pc, tr.live_kind) == 0) {
+            void *fn = (void *)qjit_ir_compile(ir, ir_n, n_exits);
+            if (fn) { tr.fn = fn; tr.n_exits = n_exits; tr.valid = 1; }
+        }
+    }
+    if (getenv("QJIT_DEBUG")) {
+        fprintf(stderr, "[qjit] COMPILE %s anchor=%d nrec=%d nt=%d ok=%d valid=%d nlive=%d\n",
+                qjit_fn_name(ctx, b), anchor, nrec, nt, ok, tr.valid, tr.n_live);
+        fprintf(stderr, "  raw recorded ops:");
+        for (int i = 0; i < nrec; i++) fprintf(stderr, " %d@%d", qjit_rec_opcode(i), qjit_rec_off(i));
+        fprintf(stderr, "\n  key OPs: get_loc0=%d get_loc3=%d get_arg0=%d add_loc=%d lt=%d if_true=%d if_false=%d goto8=%d put_loc0=%d set_loc=%d push_0=%d dup=%d get_loc=%d\n",
+                OP_get_loc0, OP_get_loc3, OP_get_arg0, OP_add_loc, OP_lt, OP_if_true, OP_if_false, OP_goto8, OP_put_loc0, OP_set_loc, OP_push_0, OP_dup, OP_get_loc);
+    }
+    qjit_store_trace(&tr);   // store valid OR invalid (memoize; don't recompile)
+    qjit_rec_consume();
+#undef GETL
+#undef EMIT
+}
+
+static int32_t qjit_try_enter(JSContext *ctx, JSFunctionBytecode *b, int32_t anchor,
+                              JSValue *var_buf, JSValue *arg_buf) {
+    if (!qjit_on()) return -1;
+    // Bake the struct offsets the heap codegen needs BEFORE compiling — qjit_ir_compile
+    // reads qjit_layout to emit element addressing (JSValue is 16 bytes on 64-bit). If this
+    // ran after qjit_try_compile, the first trace would compile with size=0 (idx*0 -> const).
+    if (!qjit_layout.jsvalue_size) {
+        qjit_layout.arr_count_off   = (int)offsetof(JSObject, u.array.count);
+        qjit_layout.arr_values_off  = (int)offsetof(JSObject, u.array.u.values);
+        qjit_layout.jsvalue_size    = (int)sizeof(JSValue);
+        qjit_layout.jsvalue_tag_off = (int)offsetof(JSValue, tag);
+        qjit_layout.tag_int         = JS_TAG_INT;
+    }
+    QjitTrace *t = qjit_lookup_trace(b, anchor);
+    if (!t) { qjit_try_compile(ctx, b, anchor); t = qjit_lookup_trace(b, anchor); }
+    if (!t || !t->valid) return -1;
+    int64_t L[64];
+    for (int k = 0; k < t->n_live; k++) {          // entry type guards, kind-specialized
+        JSValue v = t->live_is_arg[k] ? arg_buf[t->live_idx[k]] : var_buf[t->live_idx[k]];
+        if (t->live_kind[k] == QK_ARRAY) {         // must be a fast JS array -> pass JSObject*
+            if (JS_VALUE_GET_TAG(v) != JS_TAG_OBJECT) return -1;
+            JSObject *p = JS_VALUE_GET_OBJ(v);
+            if (p->class_id != JS_CLASS_ARRAY || !p->fast_array) return -1;
+            L[k] = (int64_t)(intptr_t)p;
+        } else {                                    // int payload
+            if (JS_VALUE_GET_TAG(v) != JS_TAG_INT) return -1;
+            L[k] = JS_VALUE_GET_INT(v);
+        }
+    }
+    static int dbg = -1, nofire = -1;              // cached: no getenv in the hot path
+    if (dbg < 0) { dbg = getenv("QJIT_DEBUG") ? 1 : 0; nofire = getenv("QJIT_NOFIRE") ? 1 : 0; }
+    if (dbg) fprintf(stderr, "[qjit] FIRE %s anchor=%d nlive=%d\n", qjit_fn_name(ctx, b), anchor, t->n_live);
+    if (nofire) return -1;                          // compile but don't fire (bug isolation)
+    int64_t ex = ((qjit_trace_fn)t->fn)(L);
+    for (int k = 0; k < t->n_live; k++) {          // write back int slots (immediates: no free)
+        if (t->live_kind[k] == QK_ARRAY) continue; // array locals are read-only + unchanged
+        JSValue nv = JS_MKVAL(JS_TAG_INT, (int32_t)L[k]);
+        if (t->live_is_arg[k]) arg_buf[t->live_idx[k]] = nv; else var_buf[t->live_idx[k]] = nv;
+    }
+    if (ex < 0) return anchor;                      // deopt (any reason): re-run interpreted
+    if (ex >= 0 && ex < t->n_exits) return t->exit_pc[ex];
+    return anchor;
+}
+
+/* --- qjit: opcode -> name (self-contained table, no ENABLE_DUMPS dep) --- */
+const char *qjit_opcode_name(int op) {
+    static const char * const qjit_names[] = {
+#define DEF(id, size, n_pop, n_push, f) #id,
+#include "quickjs-opcode.h"
+#undef DEF
+    };
+    if (op < 0 || op >= (int)(sizeof(qjit_names) / sizeof(qjit_names[0]))) return "<oob>";
+    return qjit_names[op];
+}
