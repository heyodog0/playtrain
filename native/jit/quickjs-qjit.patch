+/* --- qjit: opcode -> name (self-contained table, no ENABLE_DUMPS dep) --- */
+const char *qjit_opcode_name(int op) {
+    static const char * const qjit_names[] = {
+#define DEF(id, size, n_pop, n_push, f) #id,
+#define def(id, size, n_pop, n_push, f) #id,
+#include "quickjs-opcode.h"
+#undef DEF
+#undef def
+    };
+    if (op < 0 || op >= (int)(sizeof(qjit_names) / sizeof(qjit_names[0]))) return "<oob>";
+    return qjit_names[op];
+}
