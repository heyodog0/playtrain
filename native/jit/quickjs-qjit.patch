+/* linear disassembly of b around a range, gated by QJIT_DUMPBC (debug). */
+static void qjit_dump_bytecode(JSContext *ctx, JSFunctionBytecode *b) {
+    const uint8_t *buf = b->byte_code_buf; int len = b->byte_code_len;
+    fprintf(stderr, "=== bytecode dump: %s (len=%d) ===\n", qjit_fn_name(ctx, b), len);
+    for (int off = 0; off < len; ) {
+        int op = buf[off], sz = qjit_opcode_size(op);
+        fprintf(stderr, "  %4d  %-16s", off, qjit_opcode_name(op));
+        if (op == OP_goto || op == OP_if_false || op == OP_if_true)
+            fprintf(stderr, " -> %d", off + 1 + (int32_t)get_u32(buf + off + 1));
+        else if (op == OP_goto8 || op == OP_if_false8 || op == OP_if_true8)
+            fprintf(stderr, " -> %d", off + 1 + (int8_t)buf[off + 1]);
+        else if (op == OP_goto16)
+            fprintf(stderr, " -> %d", off + 1 + (int16_t)get_u16(buf + off + 1));
+        else if (sz == 3) fprintf(stderr, " #%d", get_u16(buf + off + 1));
+        else if (sz == 2) fprintf(stderr, " #%d", buf[off + 1]);
+        else if (sz == 5) fprintf(stderr, " #%d", get_u32(buf + off + 1));
+        fprintf(stderr, "\n");
+        off += sz > 0 ? sz : 1;
+    }
+}
