+/* ---- per-site property inline caches (PlayTrain prop-cache patch) ----
+   quickjs has no inline caches: every named property access walks the shape
+   hash chain (find_own_property measured 6-16% of PlayTrain's vec workload).
+   OP_get_field / OP_get_field2 / OP_put_field self-quicken into *_ic
+   variants on their first own plain-data-property hit; the IC fast path is
+   one shape-pointer compare + generation check + direct prop-array load.
+   Correctness:
+   - a hit requires the SAME shape pointer AND an unchanged global shape
+     generation; js_shape_gen is bumped on every event that can invalidate a
+     cached index or recycle a shape pointer: in-place resize (realloc may
+     move the shape), property compaction (renumbers), property deletion
+     (in-place tombstone), and shape free (ABA);
+   - the ic entry owns the atom (ownership transferred from the bytecode
+     operand at quickening; freed with the function bytecode);
+   - misses fall back to the original generic path and re-cache
+     (monomorphic, overwrite).
+   Cross-thread: envs are handed between threads only through synchronized
+   queues, so relaxed atomics on the generation suffice. */
+typedef struct JSPropIC {
+    JSShape *shape;
+    JSAtom atom;
+    uint32_t idx;
+    uint64_t gen;
+} JSPropIC;
+
+/* Sharded generations: a shape free/mutation invalidates only its own
+   pointer-hash bucket, so per-frame temporary-shape churn (measured 2-22
+   frees/step) does not evict ICs on long-lived entity shapes. Address reuse
+   maps to the same bucket, so the ABA argument is unchanged. */
+#define JS_SHAPE_GEN_BUCKETS 256
+static uint64_t js_shape_gen_tab[JS_SHAPE_GEN_BUCKETS];
+static uint64_t js_shape_gen = 1;   /* kept for diagnostics only */
+
+static inline uint32_t js_shape_gen_slot(JSShape *sh)
+{
+    uintptr_t h = (uintptr_t)sh >> 5;
+    return (uint32_t)(h ^ (h >> 11)) & (JS_SHAPE_GEN_BUCKETS - 1);
+}
+/* diagnostics (QJS_IC_STATS): counters are racy-but-indicative */
+static uint64_t js_ic_hits, js_ic_miss, js_ic_sites;
+__attribute__((destructor)) static void js_ic_stats_dump(void)
+{
+    if (getenv("QJS_IC_STATS"))
+        fprintf(stderr, "IC_STATS gen=%llu sites=%llu hits=%llu miss=%llu\n",
+                (unsigned long long)js_shape_gen,
+                (unsigned long long)js_ic_sites,
+                (unsigned long long)js_ic_hits,
+                (unsigned long long)js_ic_miss);
+}
+
+static inline uint64_t js_shape_gen_load(JSShape *sh)
+{
+    return __atomic_load_n(&js_shape_gen_tab[js_shape_gen_slot(sh)],
+                           __ATOMIC_RELAXED);
+}
+static inline void js_shape_gen_bump(JSShape *sh)
+{
+    __atomic_fetch_add(&js_shape_gen_tab[js_shape_gen_slot(sh)], 1,
+                       __ATOMIC_RELAXED);
+    js_shape_gen++;   /* diagnostics */
+}
+
+static int32_t js_prop_ic_alloc(JSContext *ctx, JSFunctionBytecode *b,
+                                JSAtom atom, JSShape *sh, uint32_t idx)
+{
+    JSPropIC *ic;
+    if (b->prop_ic_count >= b->prop_ic_size) {
+        int ns = b->prop_ic_size ? b->prop_ic_size * 2 : 16;
+        ic = js_realloc_rt(ctx->rt, b->prop_ic, sizeof(*ic) * ns);
+        if (!ic)
+            return -1;   /* no quickening; the site stays generic */
+        b->prop_ic = ic;
+        b->prop_ic_size = ns;
+    }
+    ic = &b->prop_ic[b->prop_ic_count];
+    ic->shape = sh;
+    ic->atom = atom;   /* ownership transferred from the bytecode operand */
+    ic->idx = idx;
+    ic->gen = js_shape_gen_load(sh);
+    js_ic_sites++;
+    return b->prop_ic_count++;
+}
