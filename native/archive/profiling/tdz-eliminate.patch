+/* --- TDZ read-check elimination (draft, v1: intra-basic-block) --------------
+   Downgrade OP_get_loc_check -> OP_get_loc where the lexical local is provably
+   initialized on every path reaching the read. Both ops are 3 bytes, so this is
+   an in-place opcode-byte swap: jump offsets are untouched. Conservative — resets
+   "definitely initialized" knowledge at every branch target (join), so a read is
+   downgraded only when the local is initialized on all incoming straight-line
+   paths. Removing a check on an already-initialized local cannot change any value,
+   so it is semantics-preserving (validate with a bit-exact obs trace regardless).
+   Bails on eval (dynamic scope can observe a TDZ error). TODO: also bail on `with`;
+   v2: real cross-block intersection dataflow to also catch loop induction vars. */
+static void tdz_eliminate_checks(JSContext *ctx, JSFunctionDef *s)
+{
+    uint8_t *bc = s->byte_code.buf;
+    int bc_len = s->byte_code.size;
+    int nv = s->var_count;
+    uint8_t *is_target, *inited;
+    int pos, op, size, idx, tgt;
+
+    if (nv <= 0 || s->has_eval_call || s->is_eval)
+        return;
+
+    is_target = js_mallocz(ctx, bc_len);
+    inited = js_mallocz(ctx, nv);
+    if (!is_target || !inited) { js_free(ctx, is_target); js_free(ctx, inited); return; }
+
+    /* pass 1: mark all branch targets (block join points) */
+    for (pos = 0; pos < bc_len; pos += size) {
+        op = bc[pos];
+        size = short_opcode_info(op).size;
+        tgt = -1;
+        switch (short_opcode_info(op).fmt) {
+        case OP_FMT_label8:    tgt = pos + 1 + (int8_t)bc[pos + 1]; break;
+        case OP_FMT_label16:   tgt = pos + 1 + (int16_t)get_u16(bc + pos + 1); break;
+        case OP_FMT_label:
+        case OP_FMT_label_u16: tgt = pos + 1 + (int32_t)get_u32(bc + pos + 1); break;
+        default: break;
+        }
+        if (tgt >= 0 && tgt < bc_len)
+            is_target[tgt] = 1;
+    }
+
+    /* pass 2: forward walk; downgrade checked reads of initialized locals */
+    for (pos = 0; pos < bc_len; pos += size) {
+        if (is_target[pos])
+            memset(inited, 0, nv);        /* join: intersect with empty (conservative) */
+        op = bc[pos];
+        size = short_opcode_info(op).size;
+        switch (op) {
+        case OP_get_loc_check:
+            idx = get_u16(bc + pos + 1);
+            if (idx < nv && inited[idx])
+                bc[pos] = OP_get_loc;     /* same size: in-place downgrade */
+            break;
+        case OP_put_loc: case OP_put_loc_check: case OP_put_loc_check_init: case OP_set_loc:
+            idx = get_u16(bc + pos + 1); if (idx < nv) inited[idx] = 1; break;
+        case OP_put_loc8: case OP_set_loc8:
+            idx = bc[pos + 1];           if (idx < nv) inited[idx] = 1; break;
+        case OP_put_loc0: case OP_put_loc1: case OP_put_loc2: case OP_put_loc3:
+            idx = op - OP_put_loc0;      if (idx < nv) inited[idx] = 1; break;
+        case OP_set_loc0: case OP_set_loc1: case OP_set_loc2: case OP_set_loc3:
+            idx = op - OP_set_loc0;      if (idx < nv) inited[idx] = 1; break;
+        case OP_set_loc_uninitialized:   /* fresh per-iteration binding re-enters TDZ */
+            idx = get_u16(bc + pos + 1); if (idx < nv) inited[idx] = 0; break;
+        default: break;
+        }
+    }
+    js_free(ctx, inited);
+    js_free(ctx, is_target);
+}
+
 static __exception int compute_stack_size(JSContext *ctx,
                                           JSFunctionDef *fd,
                                           int *pstack_size)
@@ -36682,6 +36752,8 @@ static JSValue js_create_function(JSContext *ctx, JSFunctionDef *fd)
     if (resolve_labels(ctx, fd))
         goto fail;
 
+    tdz_eliminate_checks(ctx, fd);   /* draft: downgrade proven-initialized get_loc_check */
+
     if (compute_stack_size(ctx, fd, &stack_size) < 0)
         goto fail;
 
