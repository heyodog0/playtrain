# Generation only. The runtime and the trainers never read a key — stepping
# environments and training agents work with none of this set.
#
#   cp .env.example .env    (.env is gitignored)

# playtrain.gen: game generation, variants, refinement (needs the `gen` extra:
# uv sync --extra gen). Billed to your Google AI Studio account.
GEMINI_API_KEY=

# Note: if GOOGLE_API_KEY is also set in your shell, the Google SDK prefers it.
# PlayTrain hides it so GEMINI_API_KEY above is the one actually used.
