{
  "game": "bigfish",
  "env_backend": "playtrain",
  "total_steps": 200000000,
  "batch_size": 256,
  "unroll_length": 64,
  "num_learner_threads": 2,
  "discounting": 0.99,
  "baseline_cost": 0.5,
  "entropy_cost": 0.01,
  "reward_clipping": "abs_one",
  "grad_norm_clipping": 40.0,
  "learning_rate": 0.0005,
  "rmsprop_alpha": 0.99,
  "rmsprop_momentum": 0.0,
  "rmsprop_epsilon": 1e-05,
  "seed": 0,
  "device": "auto",
  "obs_shape": [
    3,
    64,
    64
  ],
  "num_actions": 8,
  "features_dim": 256,
  "net": "nature",
  "use_lstm": false,
  "frame_skip": 1,
  "inference_mode": "vec",
  "vec_workers": 15,
  "vec_env_threads": 5,
  "vec_double_buffer": true,
  "vec_infer_bf16": true,
  "vec_infer_graphs": true,
  "vec_worker_device": "cuda:1,cuda:2,cuda:3",
  "vec_games_dir": "../playtrain/examples/games/js",
  "learner_precision": "bf16",
  "compile_learner": true,
  "compile_mode": "max-autotune-no-cudagraphs",
  "channels_last": true,
  "inference_sync_every": 10,
  "stats_log_every": 50,
  "eval_every_steps": 0,
  "save_every_steps": 0,
  "resume": "off",
  "log_dir": "outputs/pt_bigfish_nature_fullnode"
}